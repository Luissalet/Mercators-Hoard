# Copia como .env para activar las lecturas que aún no tienen acceso.
# Usa un token con permiso de lectura de Analytics de Cloudflare.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Si los Workers están en cuentas distintas, puedes indicar cada cuenta y token:
# WATCHHOARD_CLOUDFLARE_API_TOKEN=
# WATCHHOARD_CLOUDFLARE_ACCOUNT_ID=
# BOOKHOARD_CLOUDFLARE_API_TOKEN=
# BOOKHOARD_CLOUDFLARE_ACCOUNT_ID=
# BookHoard necesita una clave de servidor para contar usuarios de Auth.
BOOKHOARD_SUPABASE_SERVICE_ROLE_KEY=
# Opcional: carpeta de modelos de Cults preparada por Vulcan.
# MERCATOR_PRODUCTS_DIR=C:\Users\tu-usuario\Desktop\Modelos\Contornos pokemon
